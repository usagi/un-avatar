{
  "$schema": "https://json.schemastore.org/prettierrc",
  "printWidth": 140,
  "useTabs": true,
  "tabWidth": 4,
  "endOfLine": "lf",
  "singleQuote": false,
  "semi": true,
  "trailingComma": "es5",
  "bracketSameLine": false,
  "plugins": ["prettier-plugin-svelte"],
  "overrides": [
    {
      "files": "*.svelte",
      "options": {
        "parser": "svelte"
      }
    },
    {
      "files": ["*.json", "*.jsonc", "*.yaml", "*.yml", "*.md", "*.toml"],
      "options": {
        "useTabs": false,
        "tabWidth": 2
      }
    }
  ]
}
